    // Apply passed flags to passed infected or all commons if 2nd param is null
    // Returns: void
    ReapplyInfectedFlags = function(int, handle) { ::ReapplyInfectedFlags(int, handle) },
    // Register as a listener for a game event from script.
    // Returns: void
    RegisterScriptGameEventListener = function(string) { ::RegisterScriptGameEventListener(string) },
    // Reloads the MotD file
    // Returns: void
    ReloadMOTD = function() { ::ReloadMOTD() },
    // Put saved data back into the passed in table
    // Returns: void
    RestoreTable = function(string, handle) { ::RestoreTable(string, handle) },
    // Rotate a QAngle by another QAngle.
    // Returns: QAngle
    RotateOrientation = function(QAngle, QAngle) { return ::RotateOrientation(QAngle, QAngle) },
    // Rotate a Vector around a point.
    // Returns: Vector
    RotatePosition = function(Vector, QAngle, Vector) { return ::RotatePosition(Vector, QAngle, Vector) },
    // (hVictim, flRange) Make all common zombies in range rush the victim
    // Returns: void
    RushVictim = function(handle, float) { ::RushVictim(handle, float) },
    // Save the passed in table
    // Returns: void
    SaveTable = function(string, handle) { ::SaveTable(string, handle) },
    // Have Entity say string, and teamOnly or not
    // Returns: void
    Say = function(handle, string, bool) { ::Say(handle, string, bool) },
    // Start a screenfade with the following parameters. player, red, green, blue, alpha, flFadeTime, flFadeHold, flags
    // Returns: void
    ScreenFade = function(handle, int, int, int, int, float, float, int) { ::ScreenFade(handle, int, int, int, int, float, float, int) },
    // Start a screenshake with the following parameters. vecCenter, flAmplitude, flFrequency, flDuration, flRadius, eCommand( SHAKE_START = 0, SHAKE_STOP = 1 ), bAirShake
    // Returns: void
    ScreenShake = function(Vector, float, float, float, float, int, bool) { ::ScreenShake(Vector, float, float, float, float, int, bool) },
    // Makes the passed in call to g_MapScript and g_ModeScript, but it must have Zero args
    // Returns: function
    ScriptMode_SystemCall = function(callname) { return ::ScriptMode_SystemCall(callname) },
    // Pass a lambda to this, it will get called once as part of next Update, for doing something 'soon but not now'
    // Returns: function
    ScriptedMode_CallNextUpdate = function(callnext) { return ::ScriptedMode_CallNextUpdate(callnext) },
    // Send a string to the console as a client command
    // Returns: void
    SendToConsole = function(string) { ::SendToConsole(string) },
    // Send a string to the console as a server command
    // Returns: void
    SendToServerConsole = function(string) { ::SendToServerConsole(string) },
    // Sets a USERINFO client ConVar for a fakeclient
    // Returns: void
    SetFakeClientConVarValue = function(handle, string, string) { ::SetFakeClientConVarValue(handle, string, string) },
    // Set the number of Scavenge items needed.
    // Returns: void
    SetScavengeItemsGoal = function(int) { ::SetScavengeItemsGoal(int) },
    // Set the number of Scavenge items remaining.
    // Returns: void
    SetScavengeItemsRemaining = function(int) { ::SetScavengeItemsRemaining(int) },
    // Print a hud message on all clients
    // Returns: void
    ShowMessage = function(string) { ::ShowMessage(string) },
    // Spawn entity from KeyValues in table - 'name' is entity name, rest are KeyValues for spawn.
    // Returns: handle
    SpawnEntityFromTable = function(string, handle) { return ::SpawnEntityFromTable(string, handle) },
    // Hierarchically spawn an entity group from a set of spawn tables.
    // Returns: bool
    SpawnEntityGroupFromTable = function(handle) { return ::SpawnEntityGroupFromTable(handle) },
    // Auto-create a startbox that will give you a callback when the first player exits it
    // Returns: function
    SpawnStartBox = function(centerobjname, useFloating, width, depth, barriermodel, min_gap) { return ::SpawnStartBox(centerobjname, useFloating, width, depth, barriermodel, min_gap) },
    // Execute a stage table, i.e. move parameters to DirectorOptions, do callbacks and so on
    // Returns: function
    StageInfo_Execute = function(stageInfo, stageDefaults) { return ::StageInfo_Execute(stageInfo, stageDefaults) },
    // Tells all existing nextbots to swap into assault mode and not hide/dither/loiter
    // Returns: void
    StartAssault = function() { ::StartAssault() },
    // Stop named ambient sound on an entity.
    // Returns: void
    StopAmbientSoundOn = function(string, handle) { ::StopAmbientSoundOn(string, handle) },
    // Stop named sound on Entity
    // Returns: void
    StopSoundOn = function(string, handle) { ::StopSoundOn(string, handle) },
    // Store a string to a file for later reading
    // Returns: bool
    StringToFile = function(string, string) { return ::StringToFile(string, string) },
    // Teleport players to start entities named by the argument - must have 4 spawnpoints
    // Returns: function
    TeleportPlayersToStartPoints = function(spawnpointName) { return ::TeleportPlayersToStartPoints(spawnpointName) },
    // adds ticker data to a passed in HUDTable
    // Returns: function
    Ticker_AddToHud = function(hudTable, strInit, blink) { return ::Ticker_AddToHud(hudTable, strInit, blink) },
    // sets the current Ticker string, w/an optional timeout value
    // Returns: function
    Ticker_NewStr = function(newStr, newTimeout) { return ::Ticker_NewStr(newStr, newTimeout) },
    // Get the current server time
    // Returns: float
    Time = function() { return ::Time() },
    // Convert a # of seconds to a displayable time string form m:ss
    // Returns: function
    TimeToDisplayString = function(disp_time) { return ::TimeToDisplayString(disp_time) },
    // Pass table - Inputs: start, end, mask, ignore  -- outputs: pos, fraction, hit, enthit, startsolid
    // Returns: bool
    TraceLine = function(handle) { return ::TraceLine(handle) },
    // Generate a string guaranteed to be unique across the life of the script VM, with an optional root string. Useful for adding data to tables when not sure what keys are already in use in that table.
    // Returns: function
    UniqueString = function(string) { return ::UniqueString(string) },
    // Does a z_spawn like spawn based on an input table
    // Returns: bool
    ZSpawn = function(handle) { return ::ZSpawn(handle) },
    // Add a rule to the decision database.
    // Returns: bool
    rr_AddDecisionRule = function(handle) { return ::rr_AddDecisionRule(handle) },
    // Commit the result of QueryBestResponse back to the given entity to play. Call with params (entity, airesponse)
    // Returns: bool
    rr_CommitAIResponse = function(handle, handle) { return ::rr_CommitAIResponse(handle, handle) },
    // Retrieve a table of all available expresser targets, in the form { name : handle, name: handle }.
    // Returns: handle
    rr_GetResponseTargets = function() { return ::rr_GetResponseTargets() },
    // Params: (entity, query) : tests 'query' against entity's response system and returns the best response found (or null if none found).Function:    array
    // Returns: handle
    rr_QueryBestResponse = function(handle, handle) { return ::rr_QueryBestResponse(handle, handle) },
    // Throws an exception if exp is evaluated to false.
    // Returns: void
    assert = function(bool) { ::assert(bool) },
    // Returns the currently running closure.
    // Returns: function
    callee = function() { return ::callee() },
    // Runs the garbage collector and returns the number of reference cycles found(and deleted) This function only works on garbage collector builds.
    // Returns: int
    collectgarbage = function() { return ::collectgarbage() },
    // Compiles a string containing a squirrel script into a function and returns it.
    // Returns: function
    compilestring = function(string, string) { return ::compilestring(string, string) },
    // Enable/disable the debug line information generation at compile time. enable != null enables . enable == null disables.
    // Returns: void
    enabledebuginfo = function(any) { ::enabledebuginfo(any) },
    // Prints x in the standard error output.
    // Returns: void
    error = function(string) { ::error(string) },
    // Returns the const table of the VM.
    // Returns: table
    getconsttable = function() { return ::getconsttable() },
    // Returns the root table of the VM.
    // Returns: table
    getroottable = function() { return ::getroottable() },
    // Returns the stack frame informations at the given stack level (0 is the current function 1 is the caller and so on). If the stack level doesn't exist the function returns null.
    // Returns: table
    getstackinfos = function(int) { return ::getstackinfos(int) },
    // Prints message to console without any line feed after.
    // Returns: void
    print = function(string) { ::print(string) },
    // Runs the garbage collector and returns an array containing all unreachable object found. If no unreachable object is found, null is returned instead. This function is meant to help debugging reference cycles. This function only works on garbage collector builds.
    // Returns: array
    resurrectunreachable = function() { return ::resurrectunreachable() },
    // Sets the const table of the VM which also returns the previous const table.
    // Returns: table
    setconsttable = function(table) { return ::setconsttable(table) },
    // Sets the runtime error handler.
    // Returns: void
    seterrorhandler = function(func) { ::seterrorhandler(func) },
    // Sets the root table of the VM which also returns the previous root table.
    // Returns: table
    setroottable = function(table) { return ::setroottable(table) },
    // Suspends the coroutine that called this function.
    // Returns: void
    suspend = function(any) { ::suspend(any) },
    // Return the 'raw' type of an object without invoking the metatmethod '_typeof'.
    // Returns: string
    type = function(any) { return ::type(any) },
    // Returns the absolute value of x as an integer.
    // Returns: int
    abs = function(float) { return ::abs(float) },
    // Returns the arccosine of x.
    // Returns: float
    acos = function(float) { return ::acos(float) },
    // Returns the arcsine of x.
    // Returns: float
    asin = function(float) { return ::asin(float) },
    // Returns the arctangent of x.
    // Returns: float
    atan = function(float) { return ::atan(float) },
    // Returns the arctangent of x/y. Unlike atan, it does not lose quadrant information.
    // Returns: float
    atan2 = function(float, float) { return ::atan2(float, float) },
    // Returns a float value representing the smallest integer that is greater than or equal to x.
    // Returns: float
    ceil = function(float) { return ::ceil(float) },
    // Returns the cosine of x.
    // Returns: float
    cos = function(float) { return ::cos(float) },
    // Returns the exponential value (e^x) of the float parameter x.
    // Returns: float
    exp = function(float) { return ::exp(float) },
    // Returns the absolute value of x as a float.
    // Returns: float
    fabs = function(float) { return ::fabs(float) },
    // Returns a float value representing the largest integer that is less than or equal to x.
    // Returns: float
    floor = function(float) { return ::floor(float) },
    // Returns the natural logarithm of x.
    // Returns: float
    log = function(float) { return ::log(float) },
    // Returns the logarithm base-10 of x.
    // Returns: float
    log10 = function(float) { return ::log10(float) },
    // Returns x raised to the power of y.
    // Returns: float
    pow = function(float, float) { return ::pow(float, float) },
    // Returns a pseudorandom integer in the range 0 to RAND_MAX.
    // Returns: int
    rand = function() { return ::rand() },
    // Returns the sine of x.
    // Returns: float
    sin = function(float) { return ::sin(float) },
    // Returns the square root of x.
    // Returns: float
    sqrt = function(float) { return ::sqrt(float) },
    // Sets the starting point for generating a series of pseudorandom integers.
    // Returns: void
    srand = function(float) { ::srand(float) },
    // Returns the tangent of x.
    // Returns: float
    tan = function(float) { return ::tan(float) },
    // Returns a formatted string. Same rules as the standard C functions (except * is not supported).
    // Returns: string
    format = function(string, ...) {
        local args = [null, string]; args.extend(vargv)
        return ::format.acall(args)
    },
    // Removes whitespace characters at the beginning of the given string.
    // Returns: string
    lstrip = function(string) { return ::lstrip(string) },
    // Removes whitespace characters at the end of the given string.
    // Returns: string
    rstrip = function(string) { return ::rstrip(string) },
    // Returns an array of strings split at each point where a separator character occurs in str. The separator is not returned as part of any array element. the parameter separators is a string that specifies the characters as to be used for the splitting.
    // Returns: array
    split = function(string, string) { return ::split(string, string) },
    // Removes whitespace characters at both the beginning and end of the given string.
    // Returns: string
    strip = function(string) { return ::strip(string) }
}