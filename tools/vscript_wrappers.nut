CTerrorPlayerAPI <- {
    // Make the player drop an item/weapon
    // Returns: void
    DropItem = function(entity, string) { entity.DropItem(string) },
    // Extinguish a burning player
    // Returns: void
    Extinguish = function(entity) { entity.Extinguish() },
    // Try and get the current Eye Angles
    // Returns: QAngle
    EyeAngles = function(entity) { return entity.EyeAngles() },
    // Try and get the current eye position
    // Returns: Vector
    EyePosition = function(entity) { return entity.EyePosition() },
    // Get the player's active weapon
    // Returns: handle
    GetActiveWeapon = function(entity) { return entity.GetActiveWeapon() },
    // Returns the time the character has been alive (only valid when alive)
    // Returns: float
    GetAliveDuration = function(entity) { return entity.GetAliveDuration() },
    // Get the player's mask of pressed buttons
    // Returns: int
    GetButtonMask = function(entity) { return entity.GetButtonMask() },
    // Get Player Health Buffer - from pills or adrenalin etc
    // Returns: float
    GetHealthBuffer = function(entity) { return entity.GetHealthBuffer() },
    // Return the last nav area occupied - NULL if unknown
    // Returns: handle
    GetLastKnownArea = function(entity) { return entity.GetLastKnownArea() },
    // Get the player's network (i.e. Steam) ID.
    // Returns: string
    GetNetworkIDString = function(entity) { return entity.GetNetworkIDString() },
    // Get the player's name
    // Returns: string
    GetPlayerName = function(entity) { return entity.GetPlayerName() },
    // Get the player's userID.
    // Returns: int
    GetPlayerUserId = function(entity) { return entity.GetPlayerUserId() },
    // Get the current bits for the bot sense flags
    // Returns: int
    GetSenseFlags = function(entity) { return entity.GetSenseFlags() },
    // Get the Special Infected dominating this Survivor
    // Returns: handle
    GetSpecialInfectedDominatingMe = function(entity) { return entity.GetSpecialInfectedDominatingMe() },
    // Get the player's slot
    // Returns: int
    GetSurvivorSlot = function(entity) { return entity.GetSurvivorSlot() },
    // If an infected, find out what type
    // Returns: int
    GetZombieType = function(entity) { return entity.GetZombieType() },
    // Give this much ammo for your primary weapon
    // Returns: void
    GiveAmmo = function(entity, int) { entity.GiveAmmo(int) },
    // Give an item/weapon to the player
    // Returns: void
    GiveItem = function(entity, string) { entity.GiveItem(string) },
    // Give an item/weapon to the player with a skin value
    // Returns: void
    GiveItemWithSkin = function(entity, string, int) { entity.GiveItemWithSkin(string, int) },
    // Give a weapon upgrade by name
    // Returns: void
    GiveUpgrade = function(entity, int) { entity.GiveUpgrade(int) },
    // Returns true if the character has ever been injured by a member of the given team
    // Returns: bool
    HasEverBeenInjured = function(entity, int) { return entity.HasEverBeenInjured(int) },
    // Cause the vomit effect and make a player IT
    // Returns: void
    HitWithVomit = function(entity) { entity.HitWithVomit() },
    // Return true if adrenaline is active
    // Returns: bool
    IsAdrenalineActive = function(entity) { return entity.IsAdrenalineActive() },
    // Is the player dead
    // Returns: bool
    IsDead = function(entity) { return entity.IsDead() },
    // Return true if being dominated by a Special Infected
    // Returns: bool
    IsDominatedBySpecialInfected = function(entity) { return entity.IsDominatedBySpecialInfected() },
    // Player is dying, but not dead yet
    // Returns: bool
    IsDying = function(entity) { return entity.IsDying() },
    // Return true if player is firing a weapon
    // Returns: bool
    IsFiringWeapon = function(entity) { return entity.IsFiringWeapon() },
    // Return true if player is currently getting up
    // Returns: bool
    IsGettingUp = function(entity) { return entity.IsGettingUp() },
    // Is Player a Ghost
    // Returns: bool
    IsGhost = function(entity) { return entity.IsGhost() },
    // Is the player currently hanging from a ledge
    // Returns: bool
    IsHangingFromLedge = function(entity) { return entity.IsHangingFromLedge() },
    // Return true if currently IT from bile
    // Returns: bool
    IsIT = function(entity) { return entity.IsIT() },
    // Return true if currently immobilized
    // Returns: bool
    IsImmobilized = function(entity) { return entity.IsImmobilized() },
    // Return true if currently in combat
    // Returns: bool
    IsInCombat = function(entity) { return entity.IsInCombat() },
    // Is the player currently incapacitated
    // Returns: bool
    IsIncapacitated = function(entity) { return entity.IsIncapacitated() },
    // Returns whether a player is on fire
    // Returns: bool
    IsOnFire = function(entity) { return entity.IsOnFire() },
    // Return true if on third-strike
    // Returns: bool
    IsOnThirdStrike = function(entity) { return entity.IsOnThirdStrike() },
    // Return true if player is staggering
    // Returns: bool
    IsStaggering = function(entity) { return entity.IsStaggering() },
    // Returns true if falling damage is currently suppressed
    // Returns: bool
    IsSuppressingFallingDamage = function(entity) { return entity.IsSuppressingFallingDamage() },
    // On the survivor team (Otherwise, infected).
    // Returns: bool
    IsSurvivor = function(entity) { return entity.IsSurvivor() },
    // Remove a weapon upgrade by name
    // Returns: void
    RemoveUpgrade = function(entity, int) { entity.RemoveUpgrade(int) },
    // Revive a dead player by defibrillator
    // Returns: void
    ReviveByDefib = function(entity) { entity.ReviveByDefib() },
    // Revive an incapped player
    // Returns: void
    ReviveFromIncap = function(entity) { entity.ReviveFromIncap() },
    // Set Player Health Buffer - from pills or adrenalin etc
    // Returns: void
    SetHealthBuffer = function(entity, float) { entity.SetHealthBuffer(float) },
    // Set the number of times the player has been revived
    // Returns: void
    SetReviveCount = function(entity, int) { entity.SetReviveCount(int) },
    // Set the current bits for the bot sense flags - this is a SET, not an or
    // Returns: void
    SetSenseFlags = function(entity, int) { entity.SetSenseFlags(int) },
    // Sets the view angles.
    // Returns: void
    SnapEyeAngles = function(entity, QAngle) { entity.SnapEyeAngles(QAngle) },
    // Stagger a player, optionally from a vector position
    // Returns: void
    Stagger = function(entity, Vector) { entity.Stagger(Vector) },
    // Make the player switch to an item/weapon
    // Returns: bool
    SwitchToItem = function(entity, string) { return entity.SwitchToItem(string) },
    // Get a pathable location within this radius
    // Returns: Vector
    TryGetPathableLocationWithin = function(entity, float) { return entity.TryGetPathableLocationWithin(float) },
    // Cause the effect of Adrenaline - but no HP (SetHealthBuffer for that) - this is just speed!
    // Returns: void
    UseAdrenaline = function(entity, float) { entity.UseAdrenaline(float) }
}

