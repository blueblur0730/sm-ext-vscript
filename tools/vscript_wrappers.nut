    // Find entities by name nearest to a point.
    // Returns: handle
    FindByNameNearest = function(string, Vector, float) { return Entities.FindByNameNearest(string, Vector, float) },
    // Find entities by name within a radius. Pass 'null' to start an iteration, or reference to a previously found entity to continue a search
    // Returns: handle
    FindByNameWithin = function(handle, string, Vector, float) { return Entities.FindByNameWithin(handle, string, Vector, float) },
    // Find entities by targetname. Pass 'null' to start an iteration, or reference to a previously found entity to continue a search
    // Returns: handle
    FindByTarget = function(handle, string) { return Entities.FindByTarget(handle, string) },
    // Find entities within a radius. Pass 'null' to start an iteration, or reference to a previously found entity to continue a search
    // Returns: handle
    FindInSphere = function(handle, Vector, float) { return Entities.FindInSphere(handle, Vector, float) },
    // Begin an iteration over the list of entities
